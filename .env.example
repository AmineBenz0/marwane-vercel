# Runtime database configuration (set real values only in local ignored files
# or Vercel environment variables; never commit credentials).
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
MIGRATION_DATABASE_URL=

# PostgreSQL Configuration (for docker-compose)
POSTGRES_DB=comptabilite_db
POSTGRES_USER=comptabilite_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin bootstrap configuration (required only by the legacy local entrypoint).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application Configuration
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
ENABLE_AUTH=True
ENABLE_RATE_LIMITING=True
CRON_SECRET=
