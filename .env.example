# Runtime database configuration (set real values only in local ignored files
# or Vercel environment variables; never commit credentials). Use distinct
# least-privilege roles for the API and migrations.
DATABASE_URL=postgresql://app_runtime:password@host:5432/database?sslmode=require
MIGRATION_DATABASE_URL=postgresql://app_migrator:password@host:5432/database?sslmode=require

# PostgreSQL Configuration (for docker-compose)
POSTGRES_DB=comptabilite_db
POSTGRES_USER=comptabilite_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin bootstrap configuration (required only by the legacy local entrypoint).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application Configuration
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=https://app.example.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
ENABLE_AUTH=True
ENABLE_RATE_LIMITING=True
CRON_SECRET=replace-with-a-long-random-cron-secret
