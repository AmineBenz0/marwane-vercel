# Database Configuration
# Local development uses PostgreSQL on localhost. For Vercel/Supabase,
# configure the serverless transaction-pooler URL in Vercel Environment Variables
# (normally port 6543 with sslmode=require); never deploy this local value.
DATABASE_URL=postgresql://comptabilite_user:change_me_in_production@localhost:5432/comptabilite_db
# Migration-only. In staging/prod use a separate managed role such as
# app_migrator; never reuse the runtime role or a privileged admin role.
MIGRATION_DATABASE_URL=

# PostgreSQL Connection (for docker-compose)
POSTGRES_DB=comptabilite_db
POSTGRES_USER=comptabilite_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Production safety switches. Vercel's VERCEL_ENV is authoritative when present.
# Keep these enabled for preview and production deployments.
ENABLE_AUTH=False
ENABLE_RATE_LIMITING=False
CRON_SECRET=replace-with-a-long-random-cron-secret

