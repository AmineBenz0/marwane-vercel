# URL de l'API Backend
# En développement local
VITE_API_URL=

# En production avec Nginx reverse proxy
# VITE_API_URL=/api

# En production sans reverse proxy
# VITE_API_URL=http://VOTRE_IP_PUBLIQUE:8000

# Release 4: ONLY enable after Phase 8 staging migration and acceptance.
# The backend ENABLE_DEFERRED_CANCELLATION_WRITES must be enabled separately.
VITE_ENABLE_DEFERRED_CANCELLATION_WRITES=false
